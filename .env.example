# 必填：大模型服务
AI_API_KEY=

# 可选：大模型接口与模型
AI_API_BASE=https://api.xiaomimimo.com/v1
AI_MODEL=mimo-v2.5

# 英语作文批改的 Coding Plan（可直接复用 en-sense-trainer 的 LLM_* 命名）
CODING_API_BASE=https://open.bigmodel.cn/api/anthropic
CODING_MODEL=glm-4.6
CODING_API_KEY=

# 可选：本地服务与数据路径
UMI_OCR_URL=http://localhost:1224
# 写作培养原生页面地址；线上部署时改为服务器可访问的地址
WRITING_TRAINER_URL=http://localhost:8787/
# 与英语训练器服务端保持一致的随机密钥，用于站内账号同步
WRITING_SSO_SECRET=
MEMORY_DB=data/memory.db
PADDLE_OCR_LANG=ch
CSKAOYAN_ROOT=
KARPATHY_SKILLS_ROOT=

# 可选：本地或私有部署的 313 历史知识资产
HISTORY_KNOWLEDGE_CATALOG=
